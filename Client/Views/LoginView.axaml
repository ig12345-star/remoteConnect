<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="Client.Views.LoginView">

    <Grid ColumnDefinitions="1.1*, 1*">

        <!-- Left Showcase Panel -->
        <Grid Grid.Column="0">
            <!-- Background Gradient -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#090A0F" Offset="0.0"/>
                        <GradientStop Color="#141829" Offset="0.5"/>
                        <GradientStop Color="#1E1435" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Decorative Glow Accent -->
            <Ellipse Width="350" Height="350" 
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-80,-80,0,0" Opacity="0.18">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#0078F2" Offset="0.0"/>
                        <GradientStop Color="Transparent" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Left Content -->
            <StackPanel VerticalAlignment="Center" Margin="56,0,40,0" Spacing="24">
                <Border Background="#1F2338" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left">
                    <TextBlock Text="⚡ ULTRA LOW LATENCY" 
                               FontSize="11" FontWeight="Bold" 
                               Foreground="#00A3FF" LetterSpacing="1.2"/>
                </Border>

                <StackPanel Spacing="10">
                    <TextBlock Text="REMOTE" FontSize="36" FontWeight="Black" Foreground="#FFFFFF" LetterSpacing="2"/>
                    <TextBlock Text="CONNECT." FontSize="36" FontWeight="Black" Foreground="#0078F2" LetterSpacing="2"/>
                    <TextBlock Text="Fast, encrypted, and seamless remote desktop control built for modern workflows."
                               Foreground="#8E95A5" FontSize="14" TextWrapping="Wrap" MaxWidth="360" LineHeight="20"/>
                </StackPanel>

                <!-- Feature Highlights -->
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="✓" Foreground="#00E699" FontWeight="Bold"/>
                        <TextBlock Text="P2P High-performance streaming" Foreground="#D1D5DB" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="✓" Foreground="#00E699" FontWeight="Bold"/>
                        <TextBlock Text="End-to-end TLS/AES encryption" Foreground="#D1D5DB" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="✓" Foreground="#00E699" FontWeight="Bold"/>
                        <TextBlock Text="Multi-platform session control" Foreground="#D1D5DB" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Right Form Panel -->
        <Border Grid.Column="1" Background="#14161F" BorderBrush="#1F222E" BorderThickness="1,0,0,0" Padding="50,40">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" Spacing="14" MaxWidth="340">

                    <!-- Title & Subtitle -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TitleTextBlock" Text="Welcome back" 
                                   FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="SubtitleTextBlock" Text="Please enter your credentials to continue" 
                                   FontSize="13" Foreground="#7A8094"/>
                    </StackPanel>

                    <!-- Tab Switcher -->
                    <Border Background="#0C0D12" CornerRadius="8" Padding="4" Margin="0,8,0,4">
                        <Grid ColumnDefinitions="*,*">
                            <Button x:Name="SignInTabBtn" Grid.Column="0" Content="Sign In" 
                                    Click="OnSignInTabClick" Background="#1F2333" Foreground="#FFFFFF" 
                                    FontWeight="SemiBold" CornerRadius="6" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            <Button x:Name="RegisterTabBtn" Grid.Column="1" Content="Register" 
                                    Click="OnRegisterTabClick" Background="Transparent" Foreground="#6C7284" 
                                    FontWeight="SemiBold" CornerRadius="6" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Email Field (Hidden by default, shown in Register mode) -->
                    <StackPanel x:Name="EmailField" Spacing="6" IsVisible="False">
                        <TextBlock Text="EMAIL ADDRESS" Foreground="#9DA3B4" FontSize="11" FontWeight="Bold"/>
                        <TextBox x:Name="EmailTextBox" PlaceholderText="name@example.com"
                                 Background="#0C0D12" Foreground="#FFFFFF" BorderBrush="#262A3B" CornerRadius="6" Padding="12,10"/>
                    </StackPanel>

                    <!-- Username / Partner ID Field -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="USERNAME / PARTNER ID" Foreground="#9DA3B4" FontSize="11" FontWeight="Bold"/>
                        <TextBox x:Name="UsernameTextBox" PlaceholderText="Enter username or ID..."
                                 Background="#0C0D12" Foreground="#FFFFFF" BorderBrush="#262A3B" CornerRadius="6" Padding="12,10"/>
                    </StackPanel>

                    <!-- Password Field -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="PASSWORD" Foreground="#9DA3B4" FontSize="11" FontWeight="Bold"/>
                        <TextBox x:Name="PasswordTextBox" PasswordChar="●" PlaceholderText="••••••••"
                                 Background="#0C0D12" Foreground="#FFFFFF" BorderBrush="#262A3B" CornerRadius="6" Padding="12,10"/>
                    </StackPanel>

                    <!-- Confirm Password (Register mode only) -->
                    <StackPanel x:Name="ConfirmPasswordField" Spacing="6" IsVisible="False">
                        <TextBlock Text="CONFIRM PASSWORD" Foreground="#9DA3B4" FontSize="11" FontWeight="Bold"/>
                        <TextBox x:Name="ConfirmPasswordTextBox" PasswordChar="●" PlaceholderText="••••••••"
                                 Background="#0C0D12" Foreground="#FFFFFF" BorderBrush="#262A3B" CornerRadius="6" Padding="12,10"/>
                    </StackPanel>

                    <!-- Error Prompt -->
                    <TextBlock x:Name="ErrorTextBlock" Foreground="#FF4D6D" FontSize="12" 
                               IsVisible="False" TextWrapping="Wrap" HorizontalAlignment="Center"/>

                    <!-- Action Button -->
                    <Button x:Name="ActionButton" Content="Sign In" Click="OnActionButtonClick"
                            Background="#0078F2" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                            CornerRadius="8" Padding="12" Margin="0,8,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>