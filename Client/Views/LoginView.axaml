<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="Client.Views.LoginView">

    <Grid ColumnDefinitions="1.15*, 1*">

        <!-- ================= LEFT SHOWCASE PANEL ================= -->
        <Grid Grid.Column="0" ClipToBounds="True">
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#08090E" Offset="0.0"/>
                        <GradientStop Color="#0E1326" Offset="0.5"/>
                        <GradientStop Color="#1A0F2E" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Ambient Glow 1: Cyan -->
            <Ellipse Width="480" Height="480" 
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-140,-140,0,0" Opacity="0.18">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00F0FF" Offset="0.0"/>
                        <GradientStop Color="Transparent" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Ambient Glow 2: Purple / Magenta -->
            <Ellipse Width="450" Height="450" 
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-120,-120" Opacity="0.22">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7928CA" Offset="0.0"/>
                        <GradientStop Color="Transparent" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Left Foreground Content -->
            <StackPanel VerticalAlignment="Center" Margin="52,0,36,0" Spacing="26">
                <!-- Status Badge -->
                <Border Background="#121829" BorderBrush="#1E294B" BorderThickness="1" 
                        CornerRadius="20" Padding="12,6" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#00F0FF" VerticalAlignment="Center"/>
                        <TextBlock Text="REMOTE DESKTOP CLIENT" 
                                   FontSize="11" FontWeight="Bold" 
                                   Foreground="#00F0FF" LetterSpacing="1.2"/>
                    </StackPanel>
                </Border>

                <!-- Hero Title -->
                <StackPanel Spacing="6">
                    <TextBlock Text="REMOTE" FontSize="42" FontWeight="Black" Foreground="#FFFFFF" LetterSpacing="2.5"/>
                    <TextBlock Text="CONNECT." FontSize="42" FontWeight="Black" LetterSpacing="2.5">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#00F0FF" Offset="0.0"/>
                                <GradientStop Color="#7928CA" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="Fast, secure, and easy-to-use remote desktop software to connect and control your PCs anywhere."
                               Foreground="#8E9BB5" FontSize="13.5" TextWrapping="Wrap" MaxWidth="380" LineHeight="22" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Feature Cards -->
                <StackPanel Spacing="10" Margin="0,6,0,0">
                    <Border Background="#0C101D" BorderBrush="#1C243B" BorderThickness="1" CornerRadius="10" Padding="14,12" MaxWidth="380" HorizontalAlignment="Left">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#112233" Margin="0,0,12,0">
                                <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="High Performance" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="Fast streaming with minimal delay" FontSize="11.5" Foreground="#7A87A0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#0C101D" BorderBrush="#1C243B" BorderThickness="1" CornerRadius="10" Padding="14,12" MaxWidth="380" HorizontalAlignment="Left">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#261033" Margin="0,0,12,0">
                                <TextBlock Text="🔒" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Encrypted Connection" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="Full end-to-end security for your sessions" FontSize="11.5" Foreground="#7A87A0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= RIGHT FORM PANEL ================= -->
        <Border Grid.Column="1" Background="#0A0B10" BorderBrush="#1B1E2D" BorderThickness="1,0,0,0" Padding="48,36">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" Spacing="16" MaxWidth="350">

                    <!-- Header -->
                    <StackPanel Spacing="5">
                        <TextBlock x:Name="TitleTextBlock" Text="Sign In" 
                                   FontSize="28" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="SubtitleTextBlock" Text="Enter your username and password to continue" 
                                   FontSize="13" Foreground="#656F84"/>
                    </StackPanel>

                    <!-- Switcher -->
                    <Border Background="#05060A" BorderBrush="#1D2132" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,6,0,4">
                        <Grid ColumnDefinitions="*,*">
                            <Button x:Name="SignInTabBtn" Grid.Column="0" Content="Sign In" 
                                    Click="OnSignInTabClick" Background="#161B2E" Foreground="#00F0FF" 
                                    FontWeight="Bold" CornerRadius="9" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10"/>
                            <Button x:Name="RegisterTabBtn" Grid.Column="1" Content="Create Account" 
                                    Click="OnRegisterTabClick" Background="Transparent" Foreground="#656F84" 
                                    FontWeight="Bold" CornerRadius="9" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10"/>
                        </Grid>
                    </Border>

                    <!-- Email Field -->
                    <StackPanel x:Name="EmailField" Spacing="6" IsVisible="False">
                        <TextBlock Text="EMAIL" Foreground="#8996B2" FontSize="11" FontWeight="Bold" LetterSpacing="0.8"/>
                        <TextBox x:Name="EmailTextBox" PlaceholderText="you@example.com"
                                 Background="#0E1017" Foreground="#FFFFFF" BorderBrush="#202638" 
                                 CornerRadius="8" Padding="14,11"/>
                    </StackPanel>

                    <!-- Username Field -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="USERNAME" Foreground="#8996B2" FontSize="11" FontWeight="Bold" LetterSpacing="0.8"/>
                        <TextBox x:Name="UsernameTextBox" PlaceholderText="Enter your username..."
                                 Background="#0E1017" Foreground="#FFFFFF" BorderBrush="#202638" 
                                 CornerRadius="8" Padding="14,11"/>
                    </StackPanel>

                    <!-- Password Field -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="PASSWORD" Foreground="#8996B2" FontSize="11" FontWeight="Bold" LetterSpacing="0.8"/>
                        <TextBox x:Name="PasswordTextBox" PasswordChar="●" PlaceholderText="Enter your password..."
                                 Background="#0E1017" Foreground="#FFFFFF" BorderBrush="#202638" 
                                 CornerRadius="8" Padding="14,11"/>
                    </StackPanel>

                    <!-- Confirm Password Field -->
                    <StackPanel x:Name="ConfirmPasswordField" Spacing="6" IsVisible="False">
                        <TextBlock Text="CONFIRM PASSWORD" Foreground="#8996B2" FontSize="11" FontWeight="Bold" LetterSpacing="0.8"/>
                        <TextBox x:Name="ConfirmPasswordTextBox" PasswordChar="●" PlaceholderText="Repeat your password..."
                                 Background="#0E1017" Foreground="#FFFFFF" BorderBrush="#202638" 
                                 CornerRadius="8" Padding="14,11"/>
                    </StackPanel>

                    <!-- Error Alert Box -->
                    <Border x:Name="ErrorBorder" Background="#220D14" BorderBrush="#FF3366" BorderThickness="1" CornerRadius="8" Padding="12" IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="⚠" Foreground="#FF3366" FontWeight="Bold"/>
                            <TextBlock x:Name="ErrorTextBlock" Foreground="#FF6688" FontSize="12.5" 
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Button -->
                    <Button x:Name="ActionButton" Click="OnActionButtonClick"
                            CornerRadius="8" Padding="13" Margin="0,8,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#00B4D8" Offset="0.0"/>
                                <GradientStop Color="#0077B6" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock x:Name="ActionButtonText" Text="SIGN IN" FontWeight="ExtraBold" FontSize="13" Foreground="#FFFFFF" LetterSpacing="1"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>